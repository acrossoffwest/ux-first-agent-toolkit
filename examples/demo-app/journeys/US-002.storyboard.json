{
  "storyId": "US-002",
  "title": "Invite a colleague to a project",
  "baseUrl": "http://localhost:4173",
  "scenes": [
    {
      "id": "SC-01",
      "title": "Project ready, goal: invite",
      "screenId": "SCR-003",
      "narration": "Проект «Альфа» только что создан. Наша цель — позвать в него коллегу, чтобы работать вместе.",
      "minHoldSec": 2,
      "actions": [
        { "type": "goto", "url": "/" },
        { "type": "click", "selector": "testid=empty-create" },
        { "type": "fill", "selector": "testid=project-name", "value": "Альфа", "delayMs": 60 },
        { "type": "click", "selector": "testid=create-submit" },
        { "type": "expect-visible", "selector": "testid=created-note" }
      ]
    },
    {
      "id": "SC-02",
      "title": "Open the invite form",
      "screenId": "SCR-003",
      "narration": "Кнопка приглашения находится там, где ожидаешь — рядом со списком участников. Открываем форму.",
      "actions": [
        { "type": "click", "selector": "testid=invite-open" },
        { "type": "expect-visible", "selector": "testid=invite-email" }
      ]
    },
    {
      "id": "SC-03",
      "title": "Invalid email is rejected",
      "screenId": "SCR-003",
      "narration": "Сначала — опечатка в адресе. Интерфейс не теряет введённое и объясняет, как выглядит корректный адрес.",
      "actions": [
        { "type": "fill", "selector": "testid=invite-email", "value": "не-почта", "delayMs": 60 },
        { "type": "click", "selector": "testid=invite-submit" },
        { "type": "expect-text", "selector": "testid=invite-error", "text": "Введите корректный e-mail" }
      ]
    },
    {
      "id": "SC-04",
      "title": "Successful invitation",
      "screenId": "SCR-003",
      "narration": "Исправляем адрес и отправляем. Подтверждение называет адрес, а коллега появляется в списке со статусом «приглашён».",
      "minHoldSec": 2,
      "actions": [
        { "type": "fill", "selector": "testid=invite-email", "value": "anna@team.ru", "delayMs": 60 },
        { "type": "click", "selector": "testid=invite-submit" },
        { "type": "expect-text", "selector": "testid=invite-success", "text": "Приглашение отправлено на anna@team.ru" },
        { "type": "expect-text", "selector": "testid=members-list", "text": "anna@team.ru" }
      ]
    },
    {
      "id": "SC-05",
      "title": "Duplicate invite is prevented",
      "screenId": "SCR-003",
      "narration": "А если пригласить того же человека ещё раз? Дубликат не создаётся — интерфейс сообщает, что коллега уже в проекте.",
      "actions": [
        { "type": "click", "selector": "testid=invite-open" },
        { "type": "fill", "selector": "testid=invite-email", "value": "anna@team.ru", "delayMs": 60 },
        { "type": "click", "selector": "testid=invite-submit" },
        { "type": "expect-text", "selector": "testid=invite-error", "text": "уже в проекте" }
      ]
    },
    {
      "id": "SC-06",
      "title": "Status remains visible",
      "screenId": "SCR-003",
      "narration": "Закрываем форму. Статус приглашения остаётся видимым в списке участников — задача выполнена.",
      "minHoldSec": 2,
      "actions": [
        { "type": "click", "selector": "testid=invite-cancel" },
        { "type": "expect-text", "selector": "testid=members-list", "text": "приглашён" }
      ]
    }
  ]
}
